# Copy to .env for local development. Never commit .env.
# In production this is set in the Vercel project's Environment Variables.
GEMINI_API_KEY=

# Optional: override the Gemini model used by api/chat.ts.
# Default is gemini-3.5-flash-lite; on a 404 the handler retries once with
# gemini-flash-lite-latest. Check availability for your key with:
#   curl -s https://generativelanguage.googleapis.com/v1beta/models -H "x-goog-api-key: $GEMINI_API_KEY"
# GEMINI_MODEL=gemini-3.5-flash-lite
